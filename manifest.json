{
  "manifest_version": 2,
  "name": "Post Filter",
  "version": "1.0",
  "description": "Filters posts containing specified words on Reddit, Twitter, and Facebook.",
  "icons": {
    "48": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["content_script.js"],
      "css": ["styles.css"]
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "post-filter@example.com"
    }
  }
}
